# Copy to .env and fill in. .env is gitignored — this repository is public.

# PostgreSQL control plane.
DATABASE_URL=postgresql://clip:clip@localhost:5432/clip

# Discord application. Application ID and public key are not secret.
# https://discord.com/developers/applications -> General Information
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

# SECRET. Bot tab -> Reset Token. Shown once. Never commit, never paste into chat.
DISCORD_BOT_TOKEN=

# SECRET. 32+ characters. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Public origin Discord calls back to. No trailing slash.
PUBLIC_BASE_URL=https://clipendpoint.cc

# Test guild for guild-scoped command registration (immediate, vs ~1h for global).
DISCORD_TEST_GUILD_ID=
